{
  "name": "ClinicFlow",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci && npm ci --prefix frontend",
  "forwardPorts": [5173, 54321, 54323, 54324],
  "portsAttributes": {
    "5173": {
      "label": "ClinicFlow frontend",
      "onAutoForward": "openBrowser"
    },
    "54321": {
      "label": "Supabase API"
    },
    "54323": {
      "label": "Supabase Studio"
    },
    "54324": {
      "label": "Supabase email testing"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}

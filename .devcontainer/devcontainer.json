{
  "name": "ClinicFlow",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci --prefix frontend",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "ClinicFlow frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
